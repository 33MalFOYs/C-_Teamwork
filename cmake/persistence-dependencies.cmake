set(EXPENSE_CONNECTOR_ROOT "${PROJECT_SOURCE_DIR}/.tools/connector-cpp" CACHE PATH "Matching classic MySQL Connector/C++ installation")
set(EXPENSE_SODIUM_ROOT "${PROJECT_SOURCE_DIR}/.tools/libsodium-win64" CACHE PATH "libsodium MinGW x64 installation")

find_path(EXPENSE_CONNECTOR_INCLUDE mysql_driver.h HINTS "${EXPENSE_CONNECTOR_ROOT}/include/jdbc" REQUIRED)
find_library(EXPENSE_CONNECTOR_LIBRARY NAMES mysqlcppconn-static HINTS "${EXPENSE_CONNECTOR_ROOT}/lib" REQUIRED)
find_file(EXPENSE_MYSQL_C_IMPORT NAMES libmysql.lib HINTS "${EXPENSE_CONNECTOR_ROOT}/lib" REQUIRED)
find_path(EXPENSE_SODIUM_INCLUDE sodium.h HINTS "${EXPENSE_SODIUM_ROOT}/include" REQUIRED)
find_library(EXPENSE_SODIUM_LIBRARY NAMES sodium libsodium HINTS "${EXPENSE_SODIUM_ROOT}/lib" REQUIRED)

add_library(expense_mysql_connector STATIC IMPORTED)
set_target_properties(expense_mysql_connector PROPERTIES
    IMPORTED_LOCATION "${EXPENSE_CONNECTOR_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${EXPENSE_CONNECTOR_INCLUDE}"
    INTERFACE_COMPILE_DEFINITIONS STATIC_CONCPP
    INTERFACE_LINK_LIBRARIES "${EXPENSE_MYSQL_C_IMPORT};dnsapi"
)
add_library(expense_sodium UNKNOWN IMPORTED)
set_target_properties(expense_sodium PROPERTIES
    IMPORTED_LOCATION "${EXPENSE_SODIUM_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${EXPENSE_SODIUM_INCLUDE}"
)
